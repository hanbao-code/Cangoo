+/* 沿 SQLite 标准接口设置限制，不接触加密实现或连接私有布局。 */
+static PyObject* pysqlite_connection_getlimit(pysqlite_Connection* self, PyObject* args)
+{
+    int category, limit;
+    if (!pysqlite_check_thread(self) || !pysqlite_check_connection(self)) return NULL;
+    if (!PyArg_ParseTuple(args, "i:getlimit", &category)) return NULL;
+    limit = sqlite3_limit(self->db, category, -1);
+    if (limit < 0) {
+        PyErr_SetString(pysqlite_ProgrammingError, "invalid SQLite limit category");
+        return NULL;
+    }
+    return PyLong_FromLong(limit);
+}
+
+static PyObject* pysqlite_connection_setlimit(pysqlite_Connection* self, PyObject* args)
+{
+    int category, limit, previous;
+    if (!pysqlite_check_thread(self) || !pysqlite_check_connection(self)) return NULL;
+    if (!PyArg_ParseTuple(args, "ii:setlimit", &category, &limit)) return NULL;
+    previous = sqlite3_limit(self->db, category, -1);
+    if (previous < 0) {
+        PyErr_SetString(pysqlite_ProgrammingError, "invalid SQLite limit category");
+        return NULL;
+    }
+    sqlite3_limit(self->db, category, limit);
+    return PyLong_FromLong(previous);
+}
+
