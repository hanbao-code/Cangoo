<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="$(var.ProductName)" Manufacturer="hanbao-code" Version="$(var.ProductVersion)"
          UpgradeCode="$(var.BundleUpgradeCode)" Compressed="yes" IconSourceFile="$(var.AppIcon)">
    <bal:Condition Message="小仓需要 Windows 10 1809 或更新的 64 位系统。 Cangoo requires 64-bit Windows 10 1809 or later." Condition="VersionNT64 AND WindowsBuildNumber &gt;= 17763" />
    <Variable Name="InstallFolder" Type="string" Value="" Persisted="yes" />
    <Variable Name="CangooInstalled" Type="numeric" Value="0" />
    <Variable Name="CangooDesktopShortcut" Type="numeric" Value="0" />
    <Variable Name="CangooClearUserData" Type="numeric" Value="0" />
    <Variable Name="CangooCleanupPending" Type="numeric" Value="0" />
    <Variable Name="CangooCleanupResult" Type="string" Value="" />
    <Variable Name="CangooInstallError" Type="string" Value="" />
    <BootstrapperApplication>
      <!-- 无强制许可勾选；离线全文入口由同一份发行许可生成。 -->
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
          ThemeFile="$(var.SourceDir)\theme.xml" LocalizationFile="$(var.SourceDir)\en-us.wxl"
          LicenseUrl="license.html" LogoFile="$(var.AppLogo)" SuppressDowngradeFailure="no" />
      <Payload SourceFile="$(var.SourceDir)\zh-cn.wxl" Name="2052\thm.wxl" />
      <Payload SourceFile="$(var.SourceDir)\en-us.wxl" Name="1033\thm.wxl" />
      <Payload SourceFile="$(var.BuildDir)\license.html" Name="license.html" />
      <Payload SourceFile="$(var.BuildDir)\cangoo_ba_functions.dll" bal:BAFunctions="yes" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage Id="CangooMsi" SourceFile="$(var.BuildDir)\cangoo.msi" Visible="no">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="CANGOODESKTOP" Value="[CangooDesktopShortcut]" Condition="NOT CangooInstalled" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
